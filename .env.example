# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# Real environment variables override anything set here (see config.py).

# Provider: ollama | gemini | openai | offline | auto
# auto picks the first provider with credentials below, else runs offline.
LLM_PROVIDER=auto
# Model name; blank = provider default (ollama qwen2.5:1.5b, gemini gemini-1.5-flash, openai gpt-4o-mini)
LLM_MODEL=

# 1 = force offline heuristics (same as --no-llm)
LLM_OFFLINE=0
# Seconds between model calls (use 0 for local Ollama)
LLM_CALL_DELAY=4
LLM_MAX_RETRIES=5

# Google Gemini
GEMINI_API_KEY=

# OpenAI or any OpenAI-compatible endpoint (requires: pip install openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Local Ollama (run: ollama serve; ollama pull qwen2.5:1.5b)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=
